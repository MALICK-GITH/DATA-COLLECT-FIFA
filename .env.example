# Database Configuration
DB_TYPE=sqlite
SQLITE_PATH=match_history.db
DATABASE_URL=

# For PostgreSQL, uncomment and configure:
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=match_history
# DB_USER=postgres
# DB_PASSWORD=your_password

# Cron Configuration
CRON_SCHEDULE=*/5 * * * *
SCHEDULE_EVERY_MINUTES=5

# API Configuration
API_BASE_URL=https://livefeedsht-vmp.onrender.com
API_FALLBACK_BASE_URL=
API_FALLBACK_URL=
API_ENDPOINT=live-feed
API_TIMEOUT=60
API_RETRY_COUNT=3
API_RETRY_BACKOFF_SECONDS=2
API_USER_AGENT=match-saver/1.0
API_ACCEPT_ENCODING=gzip, deflate
API_USE_BROWSER_HEADERS=false
API_BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/139.0.0.0 Safari/537.36
API_BROWSER_ACCEPT=text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7
API_BROWSER_ACCEPT_LANGUAGE=fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7
API_BROWSER_CACHE_CONTROL=max-age=0
API_BROWSER_COOKIE=
API_FALLBACK_USE_BROWSER_HEADERS=false
API_FALLBACK_USER_AGENT=Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/139.0.0.0 Mobile Safari/537.36
API_FALLBACK_ACCEPT=text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7
API_FALLBACK_ACCEPT_LANGUAGE=fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7
API_FALLBACK_CACHE_CONTROL=max-age=0
API_FALLBACK_COOKIE=
USE_PLAYWRIGHT_FETCH=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=90000
PLAYWRIGHT_PRIMARY_PAGE_URL=https://888starz.bet/
PLAYWRIGHT_FALLBACK_PAGE_URL=https://1xbet.com/
API_USE_DEFAULT_PARAMS=false
API_SPORTS=85
API_COUNT=100
API_LANGUAGE=fr
API_MODE=4
# API_GROUP=
# API_COUNTRY=
# API_PARTNER=
# Example:
# API_FALLBACK_URL=https://1xbet.com/service-api/LiveFeed/Get1x2_VZip?sports=85&count=40&lng=fr&gr=285&mode=4&country=96&getEmpty=true&virtualSports=true&noFilterBlockEvent=true
API_GET_EMPTY=false
API_VIRTUAL_SPORTS=false
API_NO_FILTER_BLOCK_EVENT=false

# Webhook Security
WEBHOOK_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_FILE=match_saver.log
