# Database Configuration
DB_TYPE=sqlite
SQLITE_PATH=match_history.db
DATABASE_URL=

# For PostgreSQL, uncomment and configure:
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=match_history
# DB_USER=postgres
# DB_PASSWORD=your_password

# Cron Configuration
CRON_SCHEDULE=*/5 * * * *
SCHEDULE_EVERY_MINUTES=5

# API Configuration
API_BASE_URL=https://888starz.bet/service-api/LiveFeed
API_ENDPOINT=Get1x2_VZip
API_TIMEOUT=30
API_RETRY_COUNT=3
API_RETRY_BACKOFF_SECONDS=2
API_USER_AGENT=match-saver/1.0
API_ACCEPT_ENCODING=gzip, deflate
API_SPORTS=85
API_COUNT=100
API_LANGUAGE=fr
API_MODE=4
# API_GROUP=
# API_COUNTRY=
# API_PARTNER=
API_GET_EMPTY=false
API_VIRTUAL_SPORTS=false
API_NO_FILTER_BLOCK_EVENT=false

# Webhook Security
WEBHOOK_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_FILE=match_saver.log
